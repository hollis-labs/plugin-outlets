{
  "name": "@hollis-labs/plugin-outlets",
  "version": "0.1.0",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Named extension points for plugin UIs: a priority-ordered multi-occupant PluginOutlet and a single-occupant PluginSlot over a plugin registry.",
  "keywords": [
    "plugin",
    "outlet",
    "slot",
    "extension-point",
    "react"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hollis-labs/plugin-outlets.git"
  },
  "homepage": "https://github.com/hollis-labs/plugin-outlets#readme",
  "bugs": {
    "url": "https://github.com/hollis-labs/plugin-outlets/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.js",
    "test:run": "npm run build && node --test test/*.test.js"
  },
  "peerDependencies": {
    "@hollis-labs/plugin-registry": "^0.1.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@hollis-labs/plugin-registry": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "jsdom": "^27.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~6.0.2"
  }
}
